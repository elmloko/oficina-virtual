# Copia a .env (no se versiona). Todo es opcional.
PORT=4000
HTDOCS_ROOT=C:\xampp\htdocs
OLLAMA_URL=http://127.0.0.1:11434
MAX_CLAUDE_CONCURRENCY=2
MAX_OLLAMA_CONCURRENCY=1
